<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network use is optional; the built-in dashboard runs offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Explicitly narrow permissions; the OS retains final approval. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries>
      <intent><action android:name="android.speech.RecognitionService" /></intent>
      <package android:name="com.google.android.youtube" />
      <package android:name="com.soundcloud.android" />
      <package android:name="com.google.android.gm" />
      <package android:name="com.google.android.apps.maps" />
      <package android:name="com.google.android.calendar" />
      <package android:name="com.google.android.deskclock" />
      <package android:name="com.whatsapp" />
      <package android:name="com.android.chrome" />
    </queries>
    <application
        android:label="RAAD AI"
        android:icon="@drawable/raad_logo"
        android:roundIcon="@drawable/raad_logo"
        android:theme="@style/Theme.RAAD"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="raad" android:host="auth-complete" />
            </intent-filter>
        </activity>
        <service android:name=".WakeListeningService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>